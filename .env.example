# openchat Gemini v1 — 环境变量样例（仅安全占位符，绝不填真实值）
# 复制为 .env 或直接 export；.env 已被 .gitignore 排除，不会进入提交。
# 完整说明见 README.md「配置」与 docs/deployment-operations.md §4。

# 必填：PocketBase 数据目录（显式路径；启动以 owner-only 0700 创建。
# 测试必须使用临时目录，绝不指向生产 pb_data）
PB_DATA_DIR=/var/lib/openchat/pb_data

# 必填：专用 OpenCLI profile（不得与日常 OpenCLI 环境混用；每次调用显式传入）
OPENCLI_PROFILE=openchat-gemini

# opencli 可执行文件路径（缺省取 PATH 中的 opencli）
OPENCLI_PATH=opencli

# 监听地址。默认 127.0.0.1:8090；生产绑定受控接口并由 HTTPS/VPN 保护
OPENCLI_LISTEN_ADDR=127.0.0.1:8090

# 全局 Basic Auth。非 loopback 监听时必填，缺失则拒绝启动
BASIC_AUTH_USER=change-me-user
BASIC_AUTH_PASS=change-me-password

# 可信 Host 与可信 Origin（逗号分隔）。非 loopback 监听时必填，缺失拒绝启动
OPENCLI_TRUSTED_HOST=openchat.example.com
OPENCLI_TRUSTED_ORIGIN=https://openchat.example.com

# FIFO 队列容量（满则 429，事务内不留记录）。默认 1
OPENCLI_QUEUE_CAPACITY=1

# Gemini ask 超时秒数（kill 上限，同时传给 opencli --timeout）。默认 300
OPENCLI_TIMEOUT_SECONDS=300

# stdout/stderr 有限捕获上限（超限立即终止进程，ask 不做截断成功）。默认 4MiB / 1MiB
OPENCLI_MAX_STDOUT_BYTES=4194304
OPENCLI_MAX_STDERR_BYTES=1048576

# provider 缓存 / 探针 / 后台刷新（秒）。默认 120 / 120 / 60
OPENCLI_PROBE_TIMEOUT_SECONDS=120
OPENCLI_CACHE_TTL_SECONDS=120
OPENCLI_REFRESH_INTERVAL_SECONDS=60

# 前端构建产物目录（由后端静态托管，需先 npm run build）。默认 web/dist
OPENCLI_WEB_DIR=web/dist

# 开发免鉴权：仅监听地址为 loopback 且显式 =1 时生效；禁止 wildcard 绕过
# OPENCLI_DEV_NO_AUTH=1
